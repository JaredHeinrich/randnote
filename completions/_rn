#compdef rn

RN_ROOT_DIR="$HOME/.rn"
NOTEBOOK_DIR_NAME="notebook"
ARCHIVE_DIR_NAME="archive"

_rn() {
  typeset -A opt_args
  local context state line
  local curcontext="$curcontext"
  local ret=1

  _arguments -C -A "-*" \
    '(- *)--version[Print version]' \
    '(- *)'{-h,--help}'[Print help]' \
    '1: :_rn_subcommands' \
    '*::arg:->args' \
    && ret=0

  case "$state" in
    (args)
      case $words[1] in
        (new)
          _arguments \
            ':name -- Name of the note to be created:' \
            && ret=0
          ;;
        (open)
          _arguments \
            '::name -- Name of the note to open:_notebook' \
            '--editor+[Editor command used to open the note]:EDITOR:' \
            && ret=0
          ;;
        (remove)
          _arguments \
            ':name -- Name of the note to be deleted:_notebook' \
            && ret=0
          ;;
        (rm)
          _arguments \
            ':name -- Name of the note to be deleted:_notebook' \
            && ret=0
          ;;
        (rename)
          _arguments \
            ':name -- Name of the note to rename:_notebook' \
            ':new_name -- New name of the note:' \
             '(-f --force)'{-f,--force}'[Overwrite the note, if <NEW_NAME> is already taken]' \
            && ret=0
          ;;
        (list)
          ret=0
          ;;
        (ls)
          ret=0
          ;;
        (completions)
          _arguments \
            '--shell+[Shell for which to return the completion script]:SHELL:(zsh)' \
            && ret=0
          ;;
        (config)
          _rn_config && ret=0
          ;;
        (archive)
          _rn_archive && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

(( $+functions[_rn_subcommands] )) ||
  _rn_subcommands() {
    local -a commands=(
      "new:Create a new note"
      "open:Open a note"
      "remove:Delete a note"
      "list:List existing notes"
      "rename:Rename a note"
      "config:Access config via cli"
      "completions:Completion script for specific shell"
      "archive:View and manage archive"
    )
    _describe -t commands 'rn commands' commands "$@"
  }

(( $+functions[_rn_config_subcommands] )) ||
  _rn_config_subcommands() {
    local -a commands=(
      "generate:Generate a default config file"
      "get:Get specific config values"
      "list:List all config values"
    )
    _describe -t commands 'command' commands "$@"
  }

(( $+functions[_rn_config] )) ||
  _rn_config() {
    local ret=1
    _arguments -C \
      '1: :_rn_config_subcommands' \
      '*:: :->arg' \
      && ret=0
    case $state in
      (arg)
        case $words[1] in
          (generate)
            _arguments \
              '(-f --force)'{-f,--force}'[Overwrite the config file if one already exists]' \
              && ret=0
            ;;
          (get)
            _arguments \
              '*::value_name:(editor)' \
              && ret=0
            ;;
          (list)
            ret=0
            ;;
        esac
        ;;
    esac
    return $ret
  }

(( $+functions[_rn_archive_subcommands] )) ||
  _rn_archive_subcommands() {
    local -a commands=(
      "save:Archive a specific note"
      "list:List all archived notes"
      "open:Open a archived note"
      "restore:Restore a note from the archive"
      "remove:Delete a archived note permanently"
    )
    _describe -t commands 'command' commands "$@"
  }

(( $+functions[_rn_archive] )) ||
  _rn_archive() {
    local ret=1
    _arguments -C \
      '1: :_rn_archive_subcommands' \
      '*:: :->arg' \
      && ret=0
    case $state in
      (arg)
        case $words[1] in
          (save)
            _arguments \
              ':name -- Name of the note to archive:_notebook' \
              && ret=0
            ;;
          (list)
            ret=0
            ;;
          (open)
            _arguments \
              ':name -- Name of the note to open:_archive' \
              '--editor+[Editor command used to open the note]:EDITOR:' \
              && ret=0
            ;;
          (restore)
            _arguments \
              ':archive_name -- Name of the note to restore from archive:_archive' \
              '--new-name+[New name of the note after its restored]:NEW_NAME:' \
              '(-f --force)'{-f,--force}'[Replace existing note if name is already taken]' \
              && ret=0
            ;;
          (remove)
            _arguments \
              ':name -- Name of the note to delete from archive:_archive' \
              && ret=0
            ;;
        esac
        ;;
    esac
    return $ret
  }

(( $+functions[_notebook] )) ||
  _notebook() {
    [[ -d "$RN_ROOT_DIR/$NOTEBOOK_DIR_NAME" ]] || return 1

    local -a file_paths
    file_paths=("$RN_ROOT_DIR/$NOTEBOOK_DIR_NAME"/*(N))

    local -a file_names
    file_names=(${file_paths:t})
    _wanted note expl 'note' compadd -Q -- $file_names
  }

(( $+functions[_archive] )) ||
  _archive() {
    [[ -d "$RN_ROOT_DIR/$ARCHIVE_DIR_NAME" ]] || return 1

    local -a file_paths
    file_paths=("$RN_ROOT_DIR/$ARCHIVE_DIR_NAME"/*(N))

    local -a file_names
    file_names=(${file_paths:t})
    _wanted archived expl 'archived' compadd -Q -- $file_names
  }

_rn
