#compdef rn

autoload -U is-at-least

_rn() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_rn_commands" \
"*::: :->rn" \
&& ret=0
    case $state in
    (rn)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rn-command-$line[1]:"
        case $line[1] in
            (new)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':name -- Name of the note to be created:_default' \
&& ret=0
;;
(open)
_arguments "${_arguments_options[@]}" : \
'-e+[Editor command used to open the note]:EDITOR:_default' \
'--editor=[Editor command used to open the note]:EDITOR:_default' \
'-h[Print help]' \
'--help[Print help]' \
':name -- Name of the note to open:_default' \
&& ret=0
;;
(remove)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':name -- Name of the note to be deleted:_default' \
&& ret=0
;;
(rm)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':name -- Name of the note to be deleted:_default' \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(ls)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(rename)
_arguments "${_arguments_options[@]}" : \
'-f[Overwrite the note, if <NEW_NAME> is already taken]' \
'--force[Overwrite the note, if <NEW_NAME> is already taken]' \
'-h[Print help]' \
'--help[Print help]' \
':name -- Name of the note to rename:_default' \
':new_name -- New name of the note:_default' \
&& ret=0
;;
(config)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
":: :_rn__config_commands" \
"*::: :->config" \
&& ret=0

    case $state in
    (config)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rn-config-command-$line[1]:"
        case $line[1] in
            (generate)
_arguments "${_arguments_options[@]}" : \
'-f[Overwrite the config file if one already exists]' \
'--force[Overwrite the config file if one already exists]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(get)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'*::value_names -- Values to get from the config:_default' \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(ls)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
        esac
    ;;
esac
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'-s+[Shell for which to return the completion script]:SHELL:(zsh)' \
'--shell=[Shell for which to return the completion script]:SHELL:(zsh)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(archive)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
":: :_rn__archive_commands" \
"*::: :->archive" \
&& ret=0

    case $state in
    (archive)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rn-archive-command-$line[1]:"
        case $line[1] in
            (save)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':name -- Name of the note to archive:_default' \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(ls)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(open)
_arguments "${_arguments_options[@]}" : \
'-e+[Editor command used to open the note]:EDITOR:_default' \
'--editor=[Editor command used to open the note]:EDITOR:_default' \
'-h[Print help]' \
'--help[Print help]' \
':name -- Name of the note to open:_default' \
&& ret=0
;;
(restore)
_arguments "${_arguments_options[@]}" : \
'-n+[New name of the note after its restored]:NEW_NAME:_default' \
'--new-name=[New name of the note after its restored]:NEW_NAME:_default' \
'-f[Replace existing note if name is already taken]' \
'--force[Replace existing note if name is already taken]' \
'-h[Print help]' \
'--help[Print help]' \
':archive_name -- Name of the note to restore from archive:_default' \
&& ret=0
;;
(remove)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':name -- Name of the note to delete from archive:_default' \
&& ret=0
;;
(rm)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':name -- Name of the note to delete from archive:_default' \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_rn_commands] )) ||
_rn_commands() {
    local commands; commands=(
'new:Create a new note' \
'open:Open a note' \
'remove:Delete a note' \
'rm:Delete a note' \
'list:List existing notes' \
'ls:List existing notes' \
'rename:Rename a note' \
'config:Access config via cli' \
'completions:Completion script for specific shell' \
'archive:View and manage archive' \
    )
    _describe -t commands 'rn commands' commands "$@"
}
(( $+functions[_rn__archive_commands] )) ||
_rn__archive_commands() {
    local commands; commands=(
'save:Archive a specific note' \
'list:List all archived notes' \
'ls:List all archived notes' \
'open:Open a archived note' \
'restore:Restore a note from the archive' \
'remove:Delete a archived note permanently' \
'rm:Delete a archived note permanently' \
    )
    _describe -t commands 'rn archive commands' commands "$@"
}
(( $+functions[_rn__archive__list_commands] )) ||
_rn__archive__list_commands() {
    local commands; commands=()
    _describe -t commands 'rn archive list commands' commands "$@"
}
(( $+functions[_rn__archive__open_commands] )) ||
_rn__archive__open_commands() {
    local commands; commands=()
    _describe -t commands 'rn archive open commands' commands "$@"
}
(( $+functions[_rn__archive__remove_commands] )) ||
_rn__archive__remove_commands() {
    local commands; commands=()
    _describe -t commands 'rn archive remove commands' commands "$@"
}
(( $+functions[_rn__archive__restore_commands] )) ||
_rn__archive__restore_commands() {
    local commands; commands=()
    _describe -t commands 'rn archive restore commands' commands "$@"
}
(( $+functions[_rn__archive__save_commands] )) ||
_rn__archive__save_commands() {
    local commands; commands=()
    _describe -t commands 'rn archive save commands' commands "$@"
}
(( $+functions[_rn__completions_commands] )) ||
_rn__completions_commands() {
    local commands; commands=()
    _describe -t commands 'rn completions commands' commands "$@"
}
(( $+functions[_rn__config_commands] )) ||
_rn__config_commands() {
    local commands; commands=(
'generate:Generate a default config file' \
'get:Get specific config values' \
'list:List all config values' \
'ls:List all config values' \
    )
    _describe -t commands 'rn config commands' commands "$@"
}
(( $+functions[_rn__config__generate_commands] )) ||
_rn__config__generate_commands() {
    local commands; commands=()
    _describe -t commands 'rn config generate commands' commands "$@"
}
(( $+functions[_rn__config__get_commands] )) ||
_rn__config__get_commands() {
    local commands; commands=()
    _describe -t commands 'rn config get commands' commands "$@"
}
(( $+functions[_rn__config__list_commands] )) ||
_rn__config__list_commands() {
    local commands; commands=()
    _describe -t commands 'rn config list commands' commands "$@"
}
(( $+functions[_rn__list_commands] )) ||
_rn__list_commands() {
    local commands; commands=()
    _describe -t commands 'rn list commands' commands "$@"
}
(( $+functions[_rn__new_commands] )) ||
_rn__new_commands() {
    local commands; commands=()
    _describe -t commands 'rn new commands' commands "$@"
}
(( $+functions[_rn__open_commands] )) ||
_rn__open_commands() {
    local commands; commands=()
    _describe -t commands 'rn open commands' commands "$@"
}
(( $+functions[_rn__remove_commands] )) ||
_rn__remove_commands() {
    local commands; commands=()
    _describe -t commands 'rn remove commands' commands "$@"
}
(( $+functions[_rn__rename_commands] )) ||
_rn__rename_commands() {
    local commands; commands=()
    _describe -t commands 'rn rename commands' commands "$@"
}

if [ "$funcstack[1]" = "_rn" ]; then
    _rn "$@"
else
    compdef _rn rn
fi
